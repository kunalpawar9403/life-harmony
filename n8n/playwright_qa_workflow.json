        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 460],
      "id": "fetch-failing-jobs-node",
      "name": "Fetch Failed Jobs & Step Details",
      "continueOnFail": true
