        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"event\": \"n8n_workflow_fatal_error\",\n  \"workflow\": \"{{ $json.workflow_name }}\",\n  \"execution_id\": \"{{ $json.execution_id }}\",\n  \"failed_node\": \"{{ $json.error_node }}\",\n  \"error\": \"{{ $json.error_message }}\",\n  \"timestamp\": \"{{ $json.occurred_at }}\"\n}",
        "options": {
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-240, 720],
      "id": "send-global-error-node",
      "name": "Send Global Error Alert",
      "continueOnFail": true
    }
  ],
