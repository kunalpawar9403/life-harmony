    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Verify Run Conclusion & SHA').item.json.notification_webhook || 'https://httpbin.org/post' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"event\": \"playwright_qa_failed\",\n  \"status\": \"FAILURE\",\n  \"correlation_id\": \"{{ $('Verify Run Conclusion & SHA').item.json.correlation_id }}\",\n  \"repository\": \"{{ $('Verify Run Conclusion & SHA').item.json.repo_owner }}/{{ $('Verify Run Conclusion & SHA').item.json.repo_name }}\",\n  \"branch\": \"{{ $('Verify Run Conclusion & SHA').item.json.ref }}\",\n  \"commit_sha\": \"{{ $('Verify Run Conclusion & SHA').item.json.head_sha }}\",\n  \"run_id\": {{ $('Verify Run Conclusion & SHA').item.json.run_id }},\n  \"run_number\": {{ $('Verify Run Conclusion & SHA').item.json.run_number }},\n  \"conclusion\": \"{{ $('Verify Run Conclusion & SHA').item.json.conclusion }}\",\n  \"github_run_url\": \"{{ $('Verify Run Conclusion & SHA').item.json.html_url }}\",\n  \"failure_reason\": \"{{ $('Verify Run Conclusion & SHA').item.json.failure_reason }}\",\n  \"alert\": \"Automated QA suite detected test failures. Check GitHub Actions artifact traces for debugging.\"\n}",
        "options": {
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 460],
      "id": "fail-notification-node",
      "name": "Send Fail Notification",
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.github.com/repos/{{ $('Verify Run Conclusion & SHA').item.json.repo_owner }}/{{ $('Verify Run Conclusion & SHA').item.json.repo_name }}/issues",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"title\": \"[QA Failure Handoff] Playwright Test Run #{{ $('Verify Run Conclusion & SHA').item.json.run_number }} Failed (Ref: {{ $('Verify Run Conclusion & SHA').item.json.ref }})\",\n  \"body\": \"### 🚨 Automated QA Failure Report\\n\\n**Correlation ID:** `{{ $('Verify Run Conclusion & SHA').item.json.correlation_id }}`\\n**Repository:** `{{ $('Verify Run Conclusion & SHA').item.json.repo_owner }}/{{ $('Verify Run Conclusion & SHA').item.json.repo_name }}`\\n**Target Commit SHA:** `{{ $('Verify Run Conclusion & SHA').item.json.head_sha }}`\\n**Workflow Run:** [View GitHub Actions Run #{{ $('Verify Run Conclusion & SHA').item.json.run_number }}]({{ $('Verify Run Conclusion & SHA').item.json.html_url }})\\n\\n---\\n\\n### 🖥️ Secure Antigravity Desktop / Developer Handoff Instructions\\n*Note: n8n Cloud cannot connect directly to your local computer (`localhost`). Follow these steps to reproduce and triage safely in Antigravity or local terminal:*\\n\\n1. **Checkout the exact failing commit:**\\n   ```bash\\n   git fetch origin\\n   git checkout {{ $('Verify Run Conclusion & SHA').item.json.head_sha }}\\n   ```\\n2. **Download Artifacts & Traces:**\\n   Inspect the traces uploaded to the GitHub Actions artifacts for Run #{{ $('Verify Run Conclusion & SHA').item.json.run_number }}.\\n3. **Local Investigation:**\\n   Review the failing test spec and fix code before pushing an update.\\n\\n*Automated Handoff Dispatched by n8n Cloud Orchestrator.*\",\n  \"labels\": [\"qa-failure\", \"automated-triage\"]\n}",
        "options": {
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2220, 460],
      "id": "agent-handoff-github-issue",
      "name": "Secure Agent Handoff / Issue Creation",
      "continueOnFail": true
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [-700, 720],
      "id": "error-trigger-node",
      "name": "Global Workflow Error Trigger"
    },
    {
      "parameters": {
        "jsCode": "const errorData = $input.first().json || {};\nconst execution = errorData.execution || {};\n\nreturn [{\n  json: {\n    alert_type: 'WORKFLOW_EXECUTION_FAILURE',\n    workflow_name: execution.workflowName || 'Playwright QA Orchestrator',\n    execution_id: execution.id || 'unknown',\n    error_message: errorData.error?.message || 'Uncaught error in workflow',\n    error_node: errorData.error?.node?.name || 'unknown',\n    occurred_at: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-460, 720],
      "id": "format-error-node",
      "name": "Format Global Error Details"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://httpbin.org/post",
        "sendHeaders": true,
