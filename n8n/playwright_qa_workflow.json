        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"state\": \"failure\",\n  \"target_url\": \"{{ $json.html_url }}\",\n  \"description\": \"Playwright QA Failed (Run #{{ $json.run_number }} - {{ $json.conclusion }})\",\n  \"context\": \"n8n/playwright-qa\"\n}",
        "options": {
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 460],
      "id": "set-status-fail-node",
