      "parameters": {
        "jsCode": "// Strict Conclusion Verification\nconst data = $input.first().json;\n\nconst hasRunId = Boolean(data.run_id);\nconst isSuccessConclusion = data.conclusion === 'success';\nconst shaMatches = data.commit_sha ? data.head_sha.startsWith(data.commit_sha) : true;\n\nconst strictlyVerified = hasRunId && isSuccessConclusion && shaMatches;\n\nreturn [{\n  json: {\n    ...data,\n    verified_success: strictlyVerified,\n    sha_verified: shaMatches,\n    failure_reason: strictlyVerified ? null : (!shaMatches ? 'Commit SHA mismatch' : `Run concluded with: ${data.conclusion}`)\n  }\n}];"
