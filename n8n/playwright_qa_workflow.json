        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"state\": \"success\",\n  \"target_url\": \"{{ $json.html_url }}\",\n  \"description\": \"Playwright QA Passed (Run #{{ $json.run_number }})\",\n  \"context\": \"n8n/playwright-qa\"\n}",
        "options": {
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 240],
      "id": "set-status-success-node",
      "name": "Set GitHub Status (Success)",
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.notification_webhook || 'https://httpbin.org/post' }}",
