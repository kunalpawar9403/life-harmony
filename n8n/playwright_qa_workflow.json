    {
      "parameters": {
        "jsCode": "// Match active run & increment poll counter\nconst config = $('⚙️ Set Your GitHub Config & Token').first().json;\nconst currentPollCount = (config.poll_count || 0) + 1;\nconfig.poll_count = currentPollCount;\n\nconst runsPayload = $input.first().json || {};\nconst runs = runsPayload.workflow_runs || [];\n\nconst triggerTimestamp = new Date(config.triggered_at).getTime() - 60000;\nlet matchedRun = null;\n\nfor (const r of runs) {\n  const runCreatedAt = new Date(r.created_at).getTime();\n  const branchMatch = r.head_branch === config.ref;\n  const shaMatch = config.commit_sha ? r.head_sha.startsWith(config.commit_sha) : true;\n  \n  if (runCreatedAt >= triggerTimestamp && (branchMatch || shaMatch)) {\n    matchedRun = r;\n    break;\n  }\n}\n\nif (!matchedRun && runs.length > 0) {\n  matchedRun = runs[0];\n}\n\nconst isCompleted = matchedRun ? matchedRun.status === 'completed' : false;\nconst isTimedOut = currentPollCount >= config.max_polls;\n\nreturn [{\n  json: {\n    ...config,\n    poll_count: currentPollCount,\n    is_completed: isCompleted,\n    is_timed_out: isTimedOut,\n    run_id: matchedRun ? matchedRun.id : null,\n    run_number: matchedRun ? matchedRun.run_number : null,\n    head_sha: matchedRun ? matchedRun.head_sha : config.commit_sha,\n    status: matchedRun ? matchedRun.status : 'not_found',\n    conclusion: matchedRun ? matchedRun.conclusion : null,\n    html_url: matchedRun ? matchedRun.html_url : null,\n    updated_at: matchedRun ? matchedRun.updated_at : null\n  }\n}];"
      },
