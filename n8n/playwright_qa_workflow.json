      "parameters": {
        "jsCode": "/**\n * =========================================================================\n * ⚙️ STEP 1: CONFIGURE YOUR GITHUB REPO & TOKEN HERE\n * =========================================================================\n * Paste your GitHub Personal Access Token (PAT) below.\n * You only need to configure this single node to run the entire workflow!\n */\n\n// 1. Your GitHub Personal Access Token (Requires scopes: repo, actions, workflow)\nconst GITHUB_TOKEN = $env.GITHUB_TOKEN || 'REPLACE_WITH_YOUR_GITHUB_PAT';\n\n// 2. Target GitHub Repository\nconst REPO_OWNER = 'kunalpawar9403'; // Your GitHub username or organization\nconst REPO_NAME = 'life-harmony';    // Your repository name\nconst DEFAULT_REF = 'main';          // Default branch to test\nconst ENVIRONMENT = 'staging';       // Target environment name\n\n// 3. Optional Notification Webhook (Slack, Discord, Teams, etc.)\nconst NOTIFICATION_WEBHOOK = ''; // Leave empty if not using notifications\n\n// =========================================================================\n// Execution Logic & Correlation ID Generation (Do not modify below)\n// =========================================================================\nconst incoming = $input.first()?.json || {};\nconst body = incoming.body || incoming;\n\nconst timestamp = Date.now();\nconst randomStr = Math.random().toString(36).substring(2, 9);\nconst correlationId = body.correlation_id || `qa_corr_${timestamp}_${randomStr}`;\n\nconst finalOwner = (body.repo_owner || REPO_OWNER).trim();\nconst finalRepo = (body.repo_name || REPO_NAME).trim();\nconst finalRef = (body.ref || DEFAULT_REF).trim();\nconst finalCommitSha = (body.commit_sha || '').trim();\nconst finalToken = (body.github_token || GITHUB_TOKEN).trim();\nconst finalWebhook = (body.notification_webhook || NOTIFICATION_WEBHOOK).trim();\n\nreturn [{\n  json: {\n    github_token: finalToken,\n    repo_owner: finalOwner,\n    repo_name: finalRepo,\n    ref: finalRef,\n    commit_sha: finalCommitSha,\n    environment: ENVIRONMENT,\n    notification_webhook: finalWebhook,\n    correlation_id: correlationId,\n    triggered_at: new Date().toISOString(),\n    poll_count: 0,\n    max_polls: 30,\n    poll_interval_seconds: 15,\n    is_completed: false,\n    is_timed_out: false\n  }\n}];"
      },
