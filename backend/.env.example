PORT=5001
CLIENT_URL=https://your-frontend.vercel.app,http://localhost:5173,http://localhost:5174

# Supabase PostgreSQL Database Connection
# Option 1: Direct Connection (Recommended)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Option 2: Supabase Pooler (Transaction Mode port 6543 for serverless)
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Option 3: Individual Supabase connection fields
# DB_HOST=db.[YOUR-PROJECT-REF].supabase.co
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=[YOUR-PASSWORD]
# DB_NAME=postgres
# DB_SSL=true

# Supabase Client API Keys
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Razorpay Test / Live Keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
